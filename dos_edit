<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MS-DOS EDIT v2</title>
    <link rel="stylesheet" href="crt-theme.css">
    <link href="https://fonts.googleapis.com/css2?family=VT323&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; }
        body {
            background-color: #050505;
            font-family: 'VT323', monospace;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            overflow: hidden;
        }
        .crt-monitor {
            width: 950px;
            height: 680px;
            max-width: 98%;
        }
        .crt-screen {
            animation: powerOn 1.2s ease-out, screenFlicker 0.1s infinite 1.2s;
        }
        .top-bar {
            background: var(--phosphor);
            color: #000;
            padding: 2px 10px;
            font-size: 22px;
            font-weight: bold;
            display: flex;
            justify-content: space-between;
            z-index: 5;
            flex-shrink: 0;
        }
        .editor-container {
            flex-grow: 1;
            position: relative;
            overflow: hidden;
        }
        #editor-input {
            position: absolute;
            top: 0; left: 0;
            width: 100%;
            height: 100%;
            background: transparent;
            border: none;
            outline: none;
            resize: none;
            color: transparent;
            caret-color: var(--phosphor);
            font-family: 'VT323', monospace;
            font-size: 22px;
            line-height: 1.3;
            padding: 10px 15px;
            box-sizing: border-box;
            z-index: 2;
            white-space: pre-wrap;
            word-wrap: break-word;
            overflow: auto;
        }
        #editor-output {
            position: absolute;
            top: 0; left: 0;
            width: 100%;
            height: 100%;
            margin: 0;
            padding: 10px 15px;
            box-sizing: border-box;
            z-index: 1;
            font-family: 'VT323', monospace;
            font-size: 22px;
            line-height: 1.3;
            color: var(--phosphor);
            text-shadow: 0 0 5px var(--phosphor-dim);
            white-space: pre-wrap;
            word-wrap: break-word;
            pointer-events: none;
            overflow: hidden;
        }
        .syntax-keyword { color: var(--neon-magenta); text-shadow: 0 0 8px var(--neon-magenta); }
        .syntax-string  { color: var(--neon-green); text-shadow: 0 0 8px var(--neon-green); }
        .syntax-comment { color: #666; font-style: italic; text-shadow: none; }
        .syntax-number  { color: var(--neon-cyan); text-shadow: 0 0 8px var(--neon-cyan); }
        .syntax-html    { color: #ff8800; text-shadow: 0 0 6px rgba(255,136,0,0.5); }
        .syntax-func    { color: #ff66ff; text-shadow: 0 0 6px rgba(255,102,255,0.5); }
        .menu-bar {
            background: var(--phosphor);
            color: #000;
            padding: 0 10px;
            font-size: 22px;
            display: flex;
            gap: 25px;
            z-index: 5;
            border-top: 2px solid #000;
            flex-shrink: 0;
            position: relative;
        }
        .menu-item { cursor: pointer; position: relative; padding: 2px 0; user-select: none; }
        .menu-item u { text-decoration: underline; }
        .menu-dropdown {
            display: none;
            position: absolute;
            bottom: 30px;
            left: 0;
            background: var(--screen-bg);
            border: 2px solid var(--phosphor);
            color: var(--phosphor);
            width: 180px;
            font-size: 20px;
            box-shadow: 0 0 10px #000;
            z-index: 20;
        }
        .menu-item:hover .menu-dropdown,
        .menu-item.active .menu-dropdown { display: block; }
        .dropdown-item { padding: 5px 10px; cursor: pointer; }
        .dropdown-item:hover { background: var(--phosphor); color: #000; }
        .dropdown-item u { text-decoration: underline; }
        .dropdown-item .shortcut { float: right; color: #666; font-size: 16px; }
        .status-bar {
            background: #000;
            color: var(--phosphor);
            padding: 2px 10px;
            font-size: 18px;
            border-top: 1px solid #333;
            display: flex;
            justify-content: space-between;
            flex-shrink: 0;
        }
        .find-bar {
            display: none;
            position: absolute;
            bottom: 35px;
            right: 10px;
            background: var(--screen-bg);
            border: 2px solid var(--phosphor);
            padding: 8px;
            z-index: 20;
            gap: 6px;
            align-items: center;
        }
        .find-bar.open { display: flex; }
        .find-bar input {
            background: transparent;
            border: 1px solid var(--phosphor);
            color: var(--phosphor);
            font-family: 'VT323', monospace;
            font-size: 18px;
            padding: 2px 6px;
            outline: none;
            width: 150px;
        }
        .find-bar .match-count { color: #888; font-size: 16px; min-width: 30px; text-align: center; }
        .file-modal {
            display: none;
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.9);
            z-index: 20;
            padding: 20px;
            flex-direction: column;
        }
        .file-modal.open { display: flex; }
        .file-list {
            flex-grow: 1;
            overflow-y: auto;
            border: 1px solid var(--phosphor);
            padding: 5px;
            margin: 10px 0;
        }
        .file-item { padding: 4px 8px; cursor: pointer; color: var(--phosphor); font-size: 20px; display: flex; justify-content: space-between; }
        .file-item:hover { background: var(--phosphor); color: #000; }
        .file-item .file-size { color: #666; font-size: 16px; }
    </style>
</head>
<body>
    <div class="crt-monitor">
        <div class="crt-screen">
            <div class="file-modal" id="file-modal">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                    <span style="font-size:24px; text-shadow:0 0 8px var(--phosphor-glow);">FILE MANAGER</span>
                    <button class="crt-btn" onclick="closeFileManager()">CLOSE</button>
                </div>
                <div class="file-list" id="file-list"></div>
                <div style="display:flex; gap:10px; justify-content:flex-end; margin-top:10px;">
                    <button class="crt-btn success" onclick="saveFileDialog()">SAVE AS</button>
                </div>
            </div>
            <div class="find-bar" id="find-bar">
                <input type="text" id="find-input" placeholder="Search..." oninput="doFind()">
                <span class="match-count" id="match-count">0/0</span>
                <button class="crt-btn" onclick="findNext()">DOWN</button>
                <button class="crt-btn" onclick="findPrev()">UP</button>
                <button class="crt-btn danger" onclick="closeFind()">X</button>
            </div>
            <div class="top-bar">
                <span id="filename-display">UNTITLED.BAT</span>
                <span id="save-status">NEW</span>
            </div>
            <div class="editor-container">
                <pre id="editor-output"></pre>
                <textarea id="editor-input" spellcheck="false"></textarea>
            </div>
            <div class="menu-bar">
                <div class="menu-item">
                    <u>F</u>ile
                    <div class="menu-dropdown">
                        <div class="dropdown-item" onclick="menuNew()"><u>N</u>ew <span class="shortcut">Ctrl+N</span></div>
                        <div class="dropdown-item" onclick="menuOpenFile()"><u>O</u>pen... <span class="shortcut">Ctrl+O</span></div>
                        <div class="dropdown-item" onclick="menuSave()"><u>S</u>ave <span class="shortcut">Ctrl+S</span></div>
                        <div class="dropdown-item" onclick="saveFileDialog()">Save <u>A</u>s... <span class="shortcut">Ctrl+Shift+S</span></div>
                        <div class="dropdown-item" onclick="exportAsHTML()">Export as <u>H</u>TML</div>
                    </div>
                </div>
                <div class="menu-item">
                    <u>E</u>dit
                    <div class="menu-dropdown">
                        <div class="dropdown-item" onclick="document.execCommand('selectAll')"><u>S</u>elect All <span class="shortcut">Ctrl+A</span></div>
                        <div class="dropdown-item" onclick="menuClear()"><u>C</u>lear Text</div>
                        <div class="dropdown-item" onclick="toggleDarkMode()"><u>D</u>ark Mode</div>
                    </div>
                </div>
                <div class="menu-item">
                    <u>S</u>earch
                    <div class="menu-dropdown">
                        <div class="dropdown-item" onclick="openFind()"><u>F</u>ind... <span class="shortcut">Ctrl+F</span></div>
                        <div class="dropdown-item" onclick="menuReplace()"><u>R</u>eplace...</div>
                    </div>
                </div>
                <div class="menu-item">
                    <u>R</u>un
                    <div class="menu-dropdown">
                        <div class="dropdown-item" onclick="runPreview()"><u>P</u>review HTML</div>
                        <div class="dropdown-item" onclick="alert('Syntax Check: No errors found.')">Syntax <u>C</u>heck</div>
                    </div>
                </div>
                <div class="menu-item">
                    <u>V</u>iew
                    <div class="menu-dropdown">
                        <div class="dropdown-item" onclick="setTheme('amber')">Amber CRT</div>
                        <div class="dropdown-item" onclick="setTheme('green')">Green CRT</div>
                        <div class="dropdown-item" onclick="setTheme('vintage')">Vintage Paper</div>
                    </div>
                </div>
            </div>
            <div class="status-bar">
                <span id="line-info">Ln 1, Col 1</span>
                <span id="encoding-info">UTF-8 | DOS v2.0</span>
            </div>
        </div>
    </div>
    <script>
        const editorInput = document.getElementById('editor-input');
        const editorOutput = document.getElementById('editor-output');
        const saveStatus = document.getElementById('save-status');
        const lineInfo = document.getElementById('line-info');
        const filenameDisplay = document.getElementById('filename-display');
        const STORAGE_KEY = 'msdos_edit_file';
        let currentFilename = 'UNTITLED.BAT';
        let findResults = [];
        let findIndex = -1;
        let darkMode = true;

        function escHtml(s) {
            return s.replace(/[&<>]/g, function(m) {
                if (m === '&') return '&';
                if (m === '<') return '<';
                return '>';
            });
        }

        function toggleDarkMode() {
            darkMode = !darkMode;
            const screen = document.querySelector('.crt-screen');
            if (darkMode) {
                screen.style.background = '#0a0500';
                screen.style.color = '#FFB000';
                saveStatus.style.color = '#000';
            } else {
                screen.style.background = '#f0ead6';
                screen.style.color = '#222';
                editorOutput.style.color = '#222';
                editorOutput.style.textShadow = 'none';
            }
        }

        function setTheme(theme) {
            const root = document.documentElement;
            if (theme === 'amber') {
                root.style.setProperty('--phosphor', '#FFB000');
                root.style.setProperty('--phosphor-glow', 'rgba(255,176,0,0.7)');
                root.style.setProperty('--screen-bg', '#0a0500');
            } else if (theme === 'green') {
                root.style.setProperty('--phosphor', '#33ff00');
                root.style.setProperty('--phosphor-glow', 'rgba(51,255,0,0.7)');
                root.style.setProperty('--screen-bg', '#001100');
            } else if (theme === 'vintage') {
                root.style.setProperty('--phosphor', '#8B4513');
                root.style.setProperty('--phosphor-glow', 'rgba(139,69,19,0.5)');
                root.style.setProperty('--screen-bg', '#f5deb3');
            }
            editorInput.style.caretColor = getComputedStyle(root).getPropertyValue('--phosphor').trim();
        }

        window.onload = () => {
            const saved = localStorage.getItem(STORAGE_KEY);
            const savedName = localStorage.getItem('msdos_filename');
            if (savedName) currentFilename = savedName;
            filenameDisplay.innerText = currentFilename;
            editorInput.value = saved || '// WELCOME TO MS-DOS EDIT v2\n// TYPE YOUR CODE HERE - AUTO-SAVE IS ON\n// Press Ctrl+F to search, Ctrl+O to open files\n\nfunction initializeSystem() {\n  let version = 2026;\n  let status = "ACTIVE";\n\n  if (status === "ACTIVE") {\n    console.log("System booted. Memory: 640KB OK");\n    console.log("CRT Display: INITIALIZED");\n  }\n}\n';
            syncEditor();
            editorInput.focus();
        };

        function syncEditor() {
            const text = editorInput.value;
            localStorage.setItem(STORAGE_KEY, text);
            localStorage.setItem('msdos_filename', currentFilename);
            saveStatus.innerText = 'SAVED';
            editorOutput.innerHTML = highlightSyntax(text);
            editorOutput.scrollTop = editorInput.scrollTop;
            editorOutput.scrollLeft = editorInput.scrollLeft;
            updateLineCol();
        }

        editorInput.addEventListener('input', () => {
            saveStatus.innerText = 'TYPING...';
            clearTimeout(window.saveTimer);
            window.saveTimer = setTimeout(syncEditor, 200);
            editorOutput.innerHTML = highlightSyntax(editorInput.value);
            editorOutput.scrollTop = editorInput.scrollTop;
            updateLineCol();
        });

        editorInput.addEventListener('scroll', () => {
            editorOutput.scrollTop = editorInput.scrollTop;
            editorOutput.scrollLeft = editorInput.scrollLeft;
        });

        editorInput.addEventListener('click', updateLineCol);
        editorInput.addEventListener('keyup', updateLineCol);

        function highlightSyntax(text) {
            text = escHtml(text);
            const ph = [];
            text = text.replace(/(\/\/[^\n]*)/g, function(m) {
                ph.push('<span class="syntax-comment">' + m + '</span>');
                return '___P' + (ph.length - 1) + '___';
            });
            text = text.replace(/\/\*[\s\S]*?\*\//g, function(m) {
                ph.push('<span class="syntax-comment">' + m + '</span>');
                return '___P' + (ph.length - 1) + '___';
            });
            text = text.replace(/("(?:[^"\\]|\\.)*"|'(?:[^'\\]|\\.)*'|`(?:[^`\\]|\\.)*`)/g, function(m) {
                ph.push('<span class="syntax-string">' + m + '</span>');
                return '___P' + (ph.length - 1) + '___';
            });
            text = text.replace(/(<\/?[a-zA-Z][^&]*>)/g, function(m) {
                ph.push('<span class="syntax-html">' + m + '</span>');
                return '___P' + (ph.length - 1) + '___';
            });
            var keywords = ['var','let','const','function','if','else','return','for','while','true','false','null','undefined','async','await','new','class','import','export','from','try','catch','finally','throw','switch','case','break','continue','typeof','instanceof','this','super','yield','delete','void','in','of'];
            var kwRegex = new RegExp('\\b(' + keywords.join('|') + ')\\b', 'g');
            text = text.replace(kwRegex, '<span class="syntax-keyword">$1</span>');
            text = text.replace(/\b([a-zA-Z_$][\w$]*)\s*\(/g, '<span class="syntax-func">$1</span>(');
            text = text.replace(/\b(\d+\.?\d*)\b/g, '<span class="syntax-number">$1</span>');
            text = text.replace(/___P(\d+)___/g, function(m, idx) { return ph[parseInt(idx)] || m; });
            return text;
        }

        function updateLineCol() {
            const text = editorInput.value.substring(0, editorInput.selectionStart);
            const lines = text.split('\n');
            lineInfo.innerText = 'Ln ' + lines.length + ', Col ' + (lines[lines.length-1].length + 1);
        }

        let findTerm = '';
        function openFind() {
            document.getElementById('find-bar').classList.add('open');
            document.getElementById('find-input').focus();
            document.getElementById('find-input').select();
        }
        function closeFind() {
            document.getElementById('find-bar').classList.remove('open');
            editorInput.focus();
            clearHighlights();
        }
        function doFind() {
            findTerm = document.getElementById('find-input').value;
            if (!findTerm) {
                findResults = []; findIndex = -1;
                document.getElementById('match-count').innerText = '0/0';
                clearHighlights(); return;
            }
            const text = editorInput.value;
            findResults = [];
            let idx = text.indexOf(findTerm);
            while (idx !== -1) { findResults.push(idx); idx = text.indexOf(findTerm, idx + 1); }
            findIndex = findResults.length > 0 ? 0 : -1;
            document.getElementById('match-count').innerText = findResults.length > 0 ? (findIndex+1)+'/'+findResults.length : '0/0';
            if (findResults.length > 0) {
                highlightMatches(findIndex);
                editorInput.setSelectionRange(findResults[findIndex], findResults[findIndex] + findTerm.length);
                editorInput.focus();
            } else { clearHighlights(); }
        }
        function findNext() {
            if (findResults.length === 0) return;
            findIndex = (findIndex + 1) % findResults.length;
            document.getElementById('match-count').innerText = (findIndex+1)+'/'+findResults.length;
            highlightMatches(findIndex);
            editorInput.setSelectionRange(findResults[findIndex], findResults[findIndex] + findTerm.length);
            editorInput.focus();
        }
        function findPrev() {
            if (findResults.length === 0) return;
            findIndex = (findIndex - 1 + findResults.length) % findResults.length;
            document.getElementById('match-count').innerText = (findIndex+1)+'/'+findResults.length;
            highlightMatches(findIndex);
            editorInput.setSelectionRange(findResults[findIndex], findResults[findIndex] + findTerm.length);
            editorInput.focus();
        }
        function clearHighlights() { editorOutput.innerHTML = highlightSyntax(editorInput.value); }
        function highlightMatches(activeIdx) {
            const text = editorInput.value;
            let result = '', lastIdx = 0;
            for (let i = 0; i < findResults.length; i++) {
                const pos = findResults[i];
                result += highlightSyntax(text.substring(lastIdx, pos));
                const match = text.substring(pos, pos + findTerm.length);
                if (i === activeIdx) {
                    result += '<span style="background:#FFB000;color:#000;text-shadow:none;">' + escHtml(match) + '</span>';
                } else {
                    result += '<span style="background:rgba(255,176,0,0.3);text-shadow:none;">' + escHtml(match) + '</span>';
                }
                lastIdx = pos + findTerm.length;
            }
            result += highlightSyntax(text.substring(lastIdx));
            editorOutput.innerHTML = result;
        }

        function menuNew() {
            if (editorInput.value && !confirm('Start a new file? Unsaved changes will be lost.')) return;
            editorInput.value = '';
            currentFilename = 'UNTITLED.BAT';
            filenameDisplay.innerText = currentFilename;
            syncEditor();
        }
        function menuSave() {
            syncEditor();
            saveStatus.innerText = 'FILE SAVED';
            setTimeout(function(){ saveStatus.innerText = 'SAVED'; }, 2000);
        }
        function menuClear() {
            if (confirm('Clear all text?')) { editorInput.value = ''; syncEditor(); }
        }
        function menuReplace() {
            const old = prompt('Find what:');
            if (!old) return;
            const replacement = prompt('Replace with:');
            if (replacement === null) return;
            const text = editorInput.value;
            const regex = new RegExp(old.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'g');
            const replaced = text.replace(regex, replacement);
            if (replaced !== text) {
                editorInput.value = replaced;
                syncEditor();
                var count = (text.match(regex) || []).length;
                saveStatus.innerText = 'REPLACED: ' + count + ' OCCURRENCES';
                setTimeout(function(){ saveStatus.innerText = 'SAVED'; }, 2000);
            } else { alert('String not found.'); }
        }
        function menuOpenFile() {
            const input = document.createElement('input');
            input.type = 'file';
            input.accept = '.txt,.bat,.js,.html,.css,.py,.json,.md,.lrc,.srt';
            input.onchange = function(e) {
                const file = e.target.files[0];
                if (!file) return;
                const reader = new FileReader();
                reader.onload = function(ev) {
                    editorInput.value = ev.target.result;
                    currentFilename = file.name;
                    filenameDisplay.innerText = currentFilename;
                    syncEditor();
                };
                reader.readAsText(file);
            };
            input.click();
        }
        function saveFileDialog() {
            const name = prompt('Save file as:', currentFilename);
            if (!name) return;
            currentFilename = name;
            filenameDisplay.innerText = currentFilename;
            const blob = new Blob([editorInput.value], { type: 'text/plain' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url; a.download = currentFilename; a.click();
            URL.revokeObjectURL(url);
            saveStatus.innerText = 'DOWNLOADED';
            setTimeout(function(){ saveStatus.innerText = 'SAVED'; }, 2000);
            menuSave();
        }
        function exportAsHTML() {
            var escaped = escHtml(editorInput.value);
            var html = '<!DOCTYPE html>\n<html>\n<head>\n<meta charset="UTF-8">\n<title>Exported from DOS EDIT</title>\n<link href="https://fonts.googleapis.com/css2?family=VT323&display=swap" rel="stylesheet">\n<link rel="stylesheet" href="crt-theme.css">\n<style>\nbody { background: #050505; font-family: VT323, monospace; padding: 20px; }\npre { color: #FFB000; font-size: 18px; }\n</style>\n</head>\n<body>\n<pre>' + escaped + '</pre>\n</body>\n</html>';
            const blob = new Blob([html], { type: 'text/html' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = currentFilename.replace(/\.[^.]+$/, '') + '.html';
            a.click();
            URL.revokeObjectURL(url);
        }
        function runPreview() {
            const html = editorInput.value;
            if (html.indexOf('<html') !== -1 || html.indexOf('<!DOCTYPE') !== -1) {
                const win = window.open('', '_blank');
                win.document.write(html);
                win.document.close();
            } else {
                alert("This doesn't look like HTML. Switch to an HTML file to preview.");
            }
        }
        function closeFileManager() {
            document.getElementById('file-modal').classList.remove('open');
        }

        document.addEventListener('keydown', function(e) {
            if (e.ctrlKey && e.key === 's' && !e.shiftKey) { e.preventDefault(); menuSave(); }
            if (e.ctrlKey && e.key === 'S' && e.shiftKey) { e.preventDefault(); saveFileDialog(); }
            if (e.ctrlKey && e.key === 'n') { e.preventDefault(); menuNew(); }
            if (e.ctrlKey && e.key === 'o') { e.preventDefault(); menuOpenFile(); }
            if (e.ctrlKey && e.key === 'f') { e.preventDefault(); openFind(); }
            if (e.ctrlKey && e.key === 'h') { e.preventDefault(); menuReplace(); }
            if (e.key === 'F3') { e.preventDefault(); if (e.shiftKey) findPrev(); else findNext(); }
            if (e.key === 'Escape') { closeFind(); }
        });
        document.addEventListener('click', function(e) {
            if (!e.target.closest('.menu-item')) {
                document.querySelectorAll('.menu-item').forEach(function(m) { m.classList.remove('active'); });
            }
        });
    </script>
</body>
</html>